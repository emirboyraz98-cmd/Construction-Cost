{
  "name": "construction-cost",
  "version": "0.1.0",
  "private": true,
  "description": "İnşaat maliyet, fiyatlandırma, harcama, bağlantı ve satış takip programı",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/with-db.mjs --prepare -- next dev",
    "build": "next build",
    "start": "node scripts/with-db.mjs --prepare -- next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/with-db.mjs --generate -- prisma migrate dev",
    "db:seed": "node scripts/with-db.mjs -- tsx prisma/seed.ts",
    "db:studio": "node scripts/with-db.mjs -- prisma studio",
    "db:reset": "node scripts/with-db.mjs -- prisma migrate reset",
    "postinstall": "prisma generate",
    "baslat": "node scripts/launch.mjs",
    "demo": "node scripts/launch.mjs --demo",
    "guncelle": "node scripts/launch.mjs --update"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "^5.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
