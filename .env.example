# Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştirebilirsiniz.
# Hiçbir ayar zorunlu değildir: .env olmadan da "npm run dev" çalışır.

# --- Veritabanı ---------------------------------------------------------------
# Boş bırakılırsa proje içindeki .pgdata/ klasöründe gömülü PostgreSQL kullanılır
# (bilgisayara PostgreSQL kurmak gerekmez).
# Ayrı kurulmuş / sunucudaki bir PostgreSQL kullanmak için satırın başındaki # işaretini kaldırın:
# DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/insaat"

# Gömülü veritabanının portu (başka bir program bu portu kullanıyorsa değiştirin)
EMBEDDED_PG_PORT=5499

# --- İlk yönetici hesabı -------------------------------------------------------
# Veritabanında hiç kullanıcı yokken bir kez oluşturulur. Aşağıdakiler TEST değerleridir;
# gerçek kullanımda değiştirin ve ilk girişten sonra şifrenizi yenileyin.
SEED_ADMIN_NAME="Yönetici"
SEED_ADMIN_EMAIL="yonetici@insaat.local"
SEED_ADMIN_PASSWORD="Yonetici.2026"
